<?xml version="1.0" encoding="utf-8"?>
<!-- Full file: replace your whole AndroidManifest.xml with this -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Screen capture runs as a foreground service with a notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used if your phone refuses the accessibility overlay for the floating icon -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Internet is used ONLY when you tap "Get my hero's combo online" (Player page) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".app.MainApplication"
        android:label="MLBB Research"
        android:icon="@mipmap/ic_mlbb"
        android:roundIcon="@mipmap/ic_mlbb"
        android:largeHeap="true">

        <!-- Lets LiteRT-LM use the phone's GPU (optional: falls back to CPU) -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!-- configChanges: rotating the phone no longer restarts the app -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".controller.AccessibilityController"
            android:exported="false"
            android:label="MLBB Research"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
